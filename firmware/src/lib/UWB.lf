target C {
  platform: {
    name: "rp2040",
    board: "pololu_3pi_2040_robot"
  },
  single-threaded: true
}

preamble {=
  #include <stdio.h>
  #include "pico/stdlib.h"
  #include "hardware/uart.h"
  #include <stdlib.h>
=}

/** Polls UWB every 10 ms and outputs one number, which is the distance measured between the UWB and its anchor. */
// Non-blocking. UART triggers an interrupt when something is sent
reactor UWB {
  output dist: float
  input uart_data: string

  // useful once we have multiple uwb and ids
  reaction(uart_data) -> dist {=
    char* data = uart_data->value;
    char* endptr;
    float num = strtof(data, &endptr);
    if (endptr != data) {
      lf_set(dist, num);
    }
  =}
}