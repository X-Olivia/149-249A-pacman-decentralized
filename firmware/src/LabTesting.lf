/**
 * Template for robot driving lab exercises. This template just periodically switches between a
 * STOPPED and a DRIVING mode, updating the LCD display on each change of mode.
 */
 target C {
    platform: {
      name: "rp2040",
      board: "pololu_3pi_2040_robot"
    },
    single-threaded: true
  }
  
  import Display from "lib/Display.lf"
  import Motors from "lib/Motors.lf"
  import Line from "lib/Line.lf"
  
  
  
  reactor Robot {
    input drive: bool      // Toggle mode.
    output notify: string  // Notify of mode change.
  
    motor = new Motors();
  
      line = new Line()
    disp = new Display()
  
    timer t(0, 100 ms)
    state count: int = 0
  
    logical action clear
    state blackleft: bool = false
    state blackright: bool = false
    state blackcenter: bool = false
  
    reaction(t) -> line.trigger {=
      lf_set(line.trigger, true);
    =}
  
    initial mode calibrating {
      timer seconds(0, 1 s)  // Timer used to display seconds.
      timer end_calibration(5 s)
      reaction(startup) -> notify, motor.left_power, motor.right_power, disp.line0, disp.line1, disp.line2 {=
          lf_set(notify, "INIT");
  
          lf_set(motor.left_power, 0);
          lf_set(motor.right_power, 0);
  
        //   lf_set(disp.line0, "CALIBRATING");
        //   lf_set(disp.line1, "Roll robot over");
        //   lf_set(disp.line2, "light and dark.");
      =}
  
    //   reaction(seconds) -> disp.line3 {=
    //       static char buf[17];
    //       snprintf(buf, 17, "time:%8d s", self->count++);
    //       lf_set(disp.line3, buf);
    //   =}
  
      reaction(end_calibration) -> DRIVING, line.calibrate, motor.left_power, motor.right_power {=
          lf_set(line.calibrate, false);
          lf_set(motor.left_power, 0.15f);
          lf_set(motor.right_power, 0.15f);
          lf_set_mode(DRIVING);
      =}
  
    }
  
    mode INTERSECTION {
      reaction(clear) -> reset(RECENTER), disp.line0, motor.left_power, motor.right_power {=
        //   if (self->blackleft) {
        //       lf_set(motor.left_power, 0.2f);
        //       lf_set(motor.right_power, -0.2f);
        //       lf_schedule(clear, SEC(0.1));
        //       lf_set_mode(TURNING);
        //   }
        //   else if (self->blackright) {
        //       lf_set(motor.left_power, -0.2f);
        //       lf_set(motor.right_power, 0.2f);
        //       lf_schedule(clear, SEC(0.1));
        //       lf_set_mode(TURNING);
        //   }
        //   else if (self->blackcenter) {
        //       lf_set(motor.left_power, 0);
        //       lf_set(motor.right_power, 0);
        //   }
        static char buf0[17];
        snprintf(buf0, 17, "Intersection!%c");
        lf_set(disp.line0, buf0);
      =}
  
    }
  
    mode RECENTER {
      reaction(line.reflect) -> reset(DRIVING), disp.line0, motor.left_power, motor.right_power {=
          static char buf0[17];
          self->blackleft = (line.reflect->value[0] > 800) || (line.reflect->value[1] > 800);
          self->blackright = (line.reflect->value[3] > 800) || (line.reflect->value[4] > 800);
          self->blackcenter = (line.reflect->value[2] > 800);
          if (self->blackcenter) {
            lf_set(motor.left_power, 0.15f);
            lf_set(motor.right_power, 0.15f);
            lf_set_mode(DRIVING);
          }
          if (self->blackleft) {
                lf_set(motor.left_power, 0.075f);
                lf_set(motor.right_power, 0.15f);
                snprintf(buf0, 17, "Turning Left!%c");
          }
          else if (self->blackright) {
                lf_set(motor.left_power, 0.15);
                lf_set(motor.right_power, 0.075f);
                snprintf(buf0, 17, "Turning Right!%c");
          }
          lf_set(disp.line0, buf0);
          
      =}
    }
  
    mode DRIVING {
      reaction(line.reflect) -> RECENTER, INTERSECTION, clear, motor.left_power, motor.right_power {=
          self->blackleft = (line.reflect->value[0] > 800) || (line.reflect->value[1] > 800);
          self->blackright = (line.reflect->value[3] > 800) || (line.reflect->value[4] > 800);
          self->blackcenter = (line.reflect->value[2] > 800);
          if ((self->blackleft || self->blackright) && (self->blackcenter)) {
              lf_set(motor.left_power, 0);
              lf_set(motor.right_power, 0);
              lf_schedule(clear, SEC(0.1));
              lf_set_mode(INTERSECTION);
          }
          else if (!(self->blackcenter)) {
            //   lf_set(motor.left_power, 0);
            //   lf_set(motor.right_power, 0);
              //lf_schedule(clear, SEC(0.1));
              lf_set_mode(RECENTER);
          }
      =}
  
    }
  }
  
  main reactor {
    timer t(0, 2 sec)
    state drive: bool = false
    robot = new Robot()
    display = new Display()
    robot.notify -> display.line0
  
    reaction(t) -> robot.drive {=
      lf_set(robot.drive, self->drive);
      // Toggle the drive state variable for next time.
      self->drive = !self->drive;
    =}
  }