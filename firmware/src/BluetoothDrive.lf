target C {
  platform: {
    name: "rp2040",
    board: "pololu_3pi_2040_robot"
  },
  single-threaded: true
}

import Motors from "lib/Motors.lf"

preamble {=
  #include "hardware/uart.h"
  #include "hardware/gpio.h"
=}

reactor Bluetooth {
  output cmd: char
  timer poll(0, 10 msec)

  //Sets UART pins and baud rate
  reaction(startup) {=
    gpio_set_function(28, GPIO_FUNC_UART);  // GP28 = TX -> HM-10 RX
    gpio_set_function(29, GPIO_FUNC_UART);  // GP29 = RX <- HM-10 TX
    uart_init(uart0, 9600);
  =}

  //Checks to see if there is a command
  reaction(poll) -> cmd {=
    if (uart_is_readable(uart0)) {
      lf_set(cmd, uart_getc(uart0));
    }
  =}
}


reactor Robot {
  input cmd: char
  motor = new Motors();
  state speed: float = 0.1

  reaction(startup) -> motor.left_power, motor.right_power {=
    lf_set(motor.left_power, 0.0f);
    lf_set(motor.right_power, 0.0f);
  =}

  //Changes the robot's speed depending on what the command was
  reaction(cmd) -> motor.left_power, motor.right_power {=
    switch (cmd->value) {
      case 'w':
        lf_set(motor.left_power,  self->speed);
        lf_set(motor.right_power, self->speed);
        break;
      case 's':
        lf_set(motor.left_power,  -self->speed);
        lf_set(motor.right_power, -self->speed);
        break;
      case 'a':
        lf_set(motor.left_power,  -self->speed);
        lf_set(motor.right_power,  self->speed);
        break;
      case 'd':
        lf_set(motor.left_power,   self->speed);
        lf_set(motor.right_power, -self->speed);
        break;
      case ' ':
        lf_set(motor.left_power,  0.0f);
        lf_set(motor.right_power, 0.0f);
        break;
    }
  =}
}

main reactor {
  bt = new Bluetooth()
  robot = new Robot()
  bt.cmd -> robot.cmd
}
