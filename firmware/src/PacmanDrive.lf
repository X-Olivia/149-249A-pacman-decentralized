
target C {
  platform: {
    name: "rp2040",
    board: "pololu_3pi_2040_robot"
  },
  single-threaded: true
}

preamble {=
  #include <stdio.h>
=}

import Display from "lib/Display.lf"
import Motors from "lib/Motors.lf"
import Line from "lib/Line.lf"


reactor Robot {
  input cmd: char

  motor = new Motors()
  state speed: float = 0.1

  line = new Line()
  disp = new Display()

  timer t(0, 1 s)
  timer line_poll(0, 10 ms)

  state count: int = 0
  output notify: string

  logical action clear

  state blackleft: bool = false
  state blackright: bool = false
  state blackcenter: bool = false

  // Initialize motors
  reaction(startup) -> motor.left_power, motor.right_power {=
    lf_set(motor.left_power, 0.0f);
    lf_set(motor.right_power, 0.0f);
  =}

  // Update elapsed time
  reaction(t) -> disp.line1 {=
    static char buf[17];
    snprintf(buf, 17, "time:%8d s", self->count);
    lf_set(disp.line1, buf);
    self->count++;
  =}

  // Trigger the line sensors every 10 ms
  reaction(line_poll) -> line.trigger {=
    lf_set(line.trigger, true);
  =}

  initial mode calibrating {
    timer end_calibration(10 s)

    reaction(startup) -> notify, motor.left_power, motor.right_power, disp.line0, disp.line1, disp.line2 {=
      lf_set(notify, "INIT");

      lf_set(motor.left_power, 0.0f);
      lf_set(motor.right_power, 0.0f);

      lf_set(disp.line0, "CALIBRATING");
      lf_set(disp.line1, "Roll robot over");
      lf_set(disp.line2, "light and dark.");
    =}

    reaction(end_calibration) -> DRIVING, line.calibrate, motor.left_power, motor.right_power {=
      lf_set(line.calibrate, false);
      lf_set_mode(DRIVING);
    =}
  }

  mode BACKUP {
    reaction(clear) -> reset(DRIVING), motor.left_power, motor.right_power {=
      if (self->blackleft) {
        lf_set(motor.left_power, 0.0f);
        lf_set(motor.right_power, 0.0f);
        lf_schedule(clear, SEC(0.1));
        lf_set_mode(DRIVING);
      }
      else if (self->blackright) {
        lf_set(motor.left_power, 0.0f);
        lf_set(motor.right_power, 0.0f);
        lf_schedule(clear, SEC(0.1));
        lf_set_mode(DRIVING);
      }
      else if (self->blackcenter) {
        lf_set(motor.left_power, 0.0f);
        lf_set(motor.right_power, 0.0f);
        lf_set_mode(DRIVING);
      }
    =}
  }

  mode DRIVING {
    reaction(line.reflect) -> BACKUP, clear, disp.line0, disp.line1, disp.line2, motor.left_power, motor.right_power {=
      static char buf0[17];
      static char buf1[17];
      static char buf2[17];

      self->blackleft =
        (line.reflect->value[0] > 800) ||
        (line.reflect->value[1] > 800);

      self->blackright =
        (line.reflect->value[3] > 800) ||
        (line.reflect->value[4] > 800);

      self->blackcenter =
        (line.reflect->value[2] > 800);

      snprintf(buf0, 17, "Left:%4d", self->blackleft);
      snprintf(buf1, 17, "Center:%4d", self->blackcenter);
      snprintf(buf2, 17, "Right:%4d", self->blackright);

      if (self->blackleft || self->blackright || self->blackcenter) {
        lf_set(motor.left_power, -0.2f);
        lf_set(motor.right_power, -0.2f);

        lf_schedule(clear, SEC(0.1));
        lf_set_mode(BACKUP);
      }

      lf_set(disp.line0, buf0);
      lf_set(disp.line1, buf1);
      lf_set(disp.line2, buf2);
    =}

    // Changes the robot's speed depending on the command
    reaction(cmd) -> motor.left_power, motor.right_power {=
      switch (cmd->value) {
        case 'w':
          lf_set(motor.left_power, self->speed);
          lf_set(motor.right_power, self->speed);
          break;

        case 's':
          lf_set(motor.left_power, -self->speed);
          lf_set(motor.right_power, -self->speed);
          break;

        case 'a':
          lf_set(motor.left_power, -self->speed);
          lf_set(motor.right_power, self->speed);
          break;

        case 'd':
          lf_set(motor.left_power, self->speed);
          lf_set(motor.right_power, -self->speed);
          break;

        case ' ':
          lf_set(motor.left_power, 0.0f);
          lf_set(motor.right_power, 0.0f);
          break;
      }
    =}
  }
}


reactor Bluetooth {
  output cmd: char
  timer poll(0, 10 ms)

  // Sets UART pins and baud rate
  reaction(startup) {=
    gpio_set_function(28, GPIO_FUNC_UART);
    gpio_set_function(29, GPIO_FUNC_UART);
    uart_init(uart0, 9600);
  =}

  // Checks to see if there is a command
  reaction(poll) -> cmd {=
    if (uart_is_readable(uart0)) {
      lf_set(cmd, uart_getc(uart0));
    }
  =}
}


main reactor {
  display = new Display()
  robot = new Robot()
  bt = new Bluetooth()

  robot.notify -> display.line0
  bt.cmd -> robot.cmd
}
