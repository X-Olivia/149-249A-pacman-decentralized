/**
 */
target C {
  platform: {
    name: "rp2040",
    board: "pololu_3pi_2040_robot"
  },
  single-threaded: true,
  keepalive: true
}

import Display from "lib/Display.lf"
import GyroAngle from "lib/IMU.lf"
import MotorsWithFeedback from "lib/MotorsWithFeedback.lf"
import Encoders from "lib/Encoders.lf"
import Bluetooth from "lib/Bluetooth.lf"
import UWB from "lib/UWB.lf"
import UART from "lib/UART.lf"

preamble {=
  #include "hardware/uart.h"
  #include "hardware/gpio.h"
  #include <float.h>
  #include <stdlib.h>
  #include <time.h>
  #include <string.h>

  #define MAX_ENTRIES 20
  #define TIME_BEFORE_ROTATE_ALLOWED SEC(2)
  #define TIME_BEFORE_RESET SEC(20)
  #define NUM_DIRS 4

  // NOTE: Goes counter clockwise, unlike the simulator
  typedef enum dir_t {
    FORWARDS = 0,
    LEFT = 1,
    BACKWARDS = 2,
    RIGHT = 3
  } dir_t;

  // circular array
  typedef struct dist_arr {
    float dist[MAX_ENTRIES];
    int size;
    int tail;
  } dist_arr;

  typedef struct path_arr {
    dir_t path[NUM_DIRS];
    int size;
  } path_arr;

  typedef dist_arr dist_arr_list_t[NUM_DIRS];
=}

reactor Motion_control(p_encoder: time = 1ms, p_gyro: time = 1ms){
  input turn_angle: float
  input target_speed: float
  input stop: bool

  state speed: float = 0.1
  state target_angle: float = 0
  state start_angle: float = 0
  state curr_angle: float = 0
  timer t_encoder(0, p_encoder)
  timer t_gyro(0, p_gyro)

  motors = new MotorsWithFeedback()
  encoder = new Encoders()
  gyro = new GyroAngle()

  // ---trigger reactions------------------------------>
  reaction(t_encoder) -> encoder.trigger {=
    lf_set(encoder.trigger, true);
  =}
  reaction(t_gyro) -> gyro.trigger {=
    lf_set(gyro.trigger, true);
  =}
  encoder.left -> motors.left;
  encoder.right -> motors.right;

  // ---setter reactions------------------------------>
  reaction(target_speed) {=
    self->speed = target_speed->value;
  =}
  reaction(gyro.z) {=
    self->curr_angle = gyro.z->value;
  =}

  // for now, just forward
  initial mode FORWARD {
    reaction(startup, reset) -> motors.left_speed, motors.right_speed{=
      lf_set(motors.left_speed, self->speed);
      lf_set(motors.right_speed, self->speed);
    =}

    reaction(turn_angle) -> reset(ROTATE){=
      lf_set_mode(ROTATE);
      self->start_angle = self->curr_angle;
      self->target_angle = turn_angle->value;
    =}

    reaction(stop) -> reset(STOP){=
      lf_set_mode(STOP);
    =}
  }

  mode ROTATE {
    reaction(startup, reset) -> motors.left_speed, motors.right_speed, reset(FORWARD){=
      if (self->target_angle > 0){
        lf_set(motors.left_speed, -self->speed);
        lf_set(motors.right_speed, self->speed);
      } else if (self->target_angle == 0) {
        lf_set_mode(FORWARD);
      } else {
        lf_set(motors.left_speed, self->speed);
        lf_set(motors.right_speed, -self->speed);
      }
    =}
    reaction(gyro.z) -> reset(FORWARD) {=
      if (abs(gyro.z->value - self->start_angle) >= abs(self->target_angle)){
        lf_set_mode(FORWARD);
      }
    =}
        reaction(stop) -> reset(STOP){=
      lf_set_mode(STOP);
    =}
  }

  mode STOP {
    reaction(startup, reset) -> motors.left_speed, motors.right_speed{=
      lf_set(motors.left_speed, 0);
      lf_set(motors.right_speed, 0);
    =}
    reaction(turn_angle) -> reset(ROTATE){=
      lf_set_mode(ROTATE);
      self->start_angle = self->curr_angle;
      self->target_angle = turn_angle->value;
    =}
  }
}

reactor Ghost(p_turn: time = 1 s){
  disp = new Display()
  uwb = new UWB()
  uart = new UART()
  control = new Motion_control()
  uart.uwb_out->uwb.uart_data

  timer t_turn(0, p_turn)

  state last_distance: float = -1.0
  state curr_dir: dir_t // fixed relative to starting. A little confusing since dir_t is used for both fixed and relative.....
  state dir_to_dists: {= dist_arr_list_t =}
  state last_decision: time = 0 //(give a few seconds before deciding again)
  state last_turn: time = 0

  // once line sensors are implemented, this should be an input
  state valid_paths: path_arr

  // --- dir to dists methods -------------------------------------------------->
  method d2d_dir_reset(dir: dir_t){=
    dist_arr* arr = &self->dir_to_dists[dir];
    for (int x = 0; x < arr->size; x++){
      arr->dist[x] = 0;
    }  
    arr->size = 0;
    arr->tail = 0;
  =}
  method d2d_dir_get_last(dir: dir_t): float{=
    dist_arr* arr = &self->dir_to_dists[dir];
    return arr->dist[(arr->tail - 1 + MAX_ENTRIES) % MAX_ENTRIES];
  =}
  method d2d_dir_get_dist_roc(dir: dir_t): float{=
    float sum = 0;
    dist_arr* arr = &self->dir_to_dists[dir];
    for(int x = 0; x < arr->size; x++){
      sum += arr->dist[x];
    }
    return arr->size == 0 ? 0 : sum / arr->size;
  =}
  method d2d_dir_add_dist(dir: dir_t, dist: float){=
    dist_arr* arr = &self->dir_to_dists[dir];
    arr->dist[arr->tail] = dist;
    arr->tail = (arr->tail + 1) % MAX_ENTRIES;
    arr->size = arr->size == MAX_ENTRIES ? MAX_ENTRIES : arr->size + 1;
  =}
  method d2d_reset_all_dists(){=
    for (int x = 0; x < NUM_DIRS; x++){
      d2d_dir_reset(x);
    }  
  =}

  // --- utility methods -------------------------------------------------->
  method in_exits(exits: path_arr, dir: dir_t): bool {=
    for (int x = 0; x < exits.size; x++){
      if (exits.path[x] == dir){
        return true;
      }
    }
    return false;
  =}
  method choose_exit(exits: path_arr): dir_t{=
    // if last distance is invalid, keep going or pick a random exit -> will have to edit this
    if (self->last_distance < 0){
      return in_exits(exits, FORWARDS) ? FORWARDS : exits.path[rand() % exits.size];
    }
    // pick the best roc
    int size = self->dir_to_dists[self->curr_dir].size;
    if (in_exits(exits, FORWARDS) && size > 0 && d2d_dir_get_last(self->curr_dir) < 0){
      return FORWARDS;
    }
    float min_roc = FLT_MAX;
    dir_t min_dir = exits.path[0];
    // unlike in the simulation, I simply choose the first min_dir, since its pretty unlikely for distances to be the exact same (unless we give a closeness range?)
    for (int x = 0; x < exits.size; x++){
      dir_t rel = exits.path[x];
      float curr_roc = d2d_dir_get_dist_roc((self->curr_dir + rel) % NUM_DIRS);
      if (curr_roc < min_roc){
        min_roc = curr_roc;
        min_dir = rel;
      }
    }
    return min_dir;
  =}
  // apparently we can set ports from within methods by passing them in in the form _{reactor name}_{port name}_t*
  method turn(control: _motion_control_turn_angle_t*, rel_dir: dir_t){=
    if (rel_dir != FORWARDS){
      self->curr_dir = (self->curr_dir + rel_dir) % NUM_DIRS;
      d2d_dir_reset(self->curr_dir);
      self->last_turn = lf_time_logical_elapsed();
      lf_set(control, 360 / NUM_DIRS * rel_dir);
    }
  =}
  // --- bt -------------------------------------------------->
  method print_roc(uart: _uart_bt_in_t*){=
    static char buf[129];
    static const char* dirs[NUM_DIRS] = {"F", "L", "B", "R"};
    int n = 0;
    for (int x = 0; x < NUM_DIRS; x++){
      n += snprintf(buf + n, sizeof(buf) - n, "%s%s:%.2f", x ? "," : "", dirs[x], d2d_dir_get_dist_roc(x));
      if (n >= (int)sizeof(buf)) break;
    }
    lf_set(uart, buf);
  =}

  // --- reactions -------------------------------------------------->
  reaction(startup) {=
    self->valid_paths.path[0] = FORWARDS;
    self->valid_paths.path[1] = LEFT;
    self->valid_paths.path[2] = BACKWARDS;
    self->valid_paths.path[3] = RIGHT;
    self->valid_paths.size = NUM_DIRS;
    self->curr_dir = FORWARDS;
    srand((unsigned int)time(NULL));
    memset(self->dir_to_dists, 0, sizeof(self->dir_to_dists));
  =}
  reaction(t_turn) -> control.turn_angle, uart.bt_in {=
    print_roc(uart.bt_in);
    if (lf_time_logical_elapsed() > self->last_decision + TIME_BEFORE_ROTATE_ALLOWED){
      self->last_decision = lf_time_logical_elapsed();
      if (self->valid_paths.size == 1){
        // deadend. There is only one path
        dir_t rel_dir = self->valid_paths.path[0];
        turn(control.turn_angle, rel_dir);
        return;
      } else {
        dir_t rel_dir;
        // every once in a while try a new path time spent on current dir is too long
        if (lf_time_logical_elapsed() > self->last_turn + TIME_BEFORE_RESET){
          d2d_reset_all_dists();
          do {
            rel_dir = self->valid_paths.path[rand() % self->valid_paths.size];
          } while (rel_dir == FORWARDS);
        } else {
          rel_dir = choose_exit(self->valid_paths);
        }
        turn(control.turn_angle, rel_dir);
        return;
      }
    }
  =}
  reaction(uwb.dist){=
    if(self->last_distance >= 0){
      d2d_dir_add_dist(self->curr_dir, uwb.dist->value - self->last_distance);
    }
    self->last_distance = uwb.dist->value;
  =}
    reaction(uwb.dist) -> disp.line0, uart.bt_in{=
    static char buf[17];
    snprintf(buf, 17, "Dist: %.2f cm", uwb.dist->value);
    lf_set(disp.line0, buf);
  =}
}

reactor Pacman(sample_period: time = 10 ms){
  input cmd: char
  disp = new Display()
  control = new Motion_control()

  reaction(cmd) -> control.turn_angle, control.stop{=
    float s = 0.1f;  // 30% power; keep low for the first test
    switch (cmd->value) {
      case 'w': lf_set(control.turn_angle, 0); break;
      case 's': lf_set(control.turn_angle, 180); break;
      case 'a': lf_set(control.turn_angle, 90); break;
      case 'd': lf_set(control.turn_angle, -90); break;
      case 'S': lf_set(control.stop, true); break;
    }
  =}
}

main reactor {
  bt = new Bluetooth()
  ghost = new Ghost()
  // pacman = new Pacman()
  // bt.cmd -> pacman.cmd
}
